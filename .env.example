ANTHROPIC_API_KEY=
MODEL_EXTRACT=claude-sonnet-5-5
MODEL_ANALYST=claude-sonnet-5-5
MODEL_FAST=claude-haiku-4-5-20251001
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string for the postgres role
SUPABASE_DB_URL=
# Written by `npm run db:migrate` (read only role for the analyst SQL tool)
SUPABASE_DB_READONLY_URL=
DAILY_SPEND_CAP_INR=500
PER_IP_HOURLY_CALLS=60
DEFAULT_USD_INR=96
DEFAULT_GST_PCT=18
# Optional: lower the hard Rs 300 session cap for model calls (cannot raise it)
SESSION_BUDGET_INR=
# Optional. Lets a script call POST /api/reset-demo without the per IP limit (header x-admin-token).
DEMO_ADMIN_TOKEN=
# Optional. Extra salt for the IP hash. Falls back to a value derived from SUPABASE_SERVICE_ROLE_KEY.
IP_HASH_SALT=
# Optional. Pins the budget guard to one session id instead of the per day id used on Vercel.
QD_BUDGET_SESSION=
