{
  "name": "quotedesk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:gen": ".venv/bin/python seed/generate.py",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed:db": "tsx seed/load.ts",
    "extract:all": "tsx scripts/extract-all.ts",
    "eval": "tsx eval/run.ts",
    "api:ping": "tsx scripts/ping.ts",
    "debug:cache": "tsx scripts/debug-cache.ts",
    "recompute": "tsx scripts/recompute.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "serve:prod": "tsx scripts/serve-prod.ts",
    "demo:reset": "tsx scripts/reset-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "mailparser": "^3.9.36",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^22.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
